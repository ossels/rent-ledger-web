generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The two owners of the household ledger. `key` is the stable identity the
// design system's party colors hang off ("a" = teal, "b" = marigold).
model Party {
  id   String @id @default(cuid())
  key  String @unique // "a" | "b"
  name String
  note String?

  @@map("parties")
}

enum OwnerKind {
  A
  B
  SHARED
}

model Building {
  id       String    @id @default(cuid())
  name     String
  unit     String
  area     String?
  tenant   String?
  rent     Int // agreed monthly rent, whole rupees
  splitA   Int // party A's fixed share of the rent
  splitB   Int // party B's fixed share of the rent
  owner    OwnerKind
  archived Boolean   @default(false)
  entries  Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("buildings")
}

enum EntryKind {
  RENT
  EXPENSE
}

enum EntryStatus {
  COLLECTED
  AWAITED
  PARTIAL
  PAID
}

// One ledger line. Nothing is ever overwritten: history stays browsable by month.
model Entry {
  id         String      @id @default(cuid())
  building   Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  buildingId String
  kind       EntryKind
  month      String // "2026-08"
  day        Int
  total      Int // whole rupees
  received   Int         @default(0) // cached sum(payments); status is derived from it for rent
  splitA     Int
  splitB     Int
  status     EntryStatus
  note       String?
  receiptPath String? // one photo per entry, stored under RECEIPTS_DIR

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
  @@index([buildingId, month])
  @@map("entries")
}

// One installment against a rent entry. Counts toward the entry's ledger month
// regardless of the payment date (August rent paid 5 Sep is August's collection).
model Payment {
  id      String  @id @default(cuid())
  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String
  amount  Int // whole rupees
  date    String // "2026-09-05"
  note    String?

  createdAt DateTime @default(now())

  @@index([entryId])
  @@map("payments")
}

// Login accounts. The first account is created by the setup screen; further
// accounts can be added by an authenticated user.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Settings {
  id           Int     @id @default(1)
  currencyCode String  @default("INR")
  locale       String  @default("en-IN")
  timezone     String  @default("Asia/Kolkata")
  autoCarry    Boolean @default(true)
  reminder     Boolean @default(true)
  confirmClose Boolean @default(false)

  @@map("settings")
}

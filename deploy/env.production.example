# Copy to /opt/rentledger/.env on the server and fill the secrets:
#   openssl rand -base64 48   # once per secret
#
# This stack runs its OWN Postgres container on the compose-internal network — it is
# not published to the host at all, so it cannot collide with the Postgres another
# app already runs on this VPS.

POSTGRES_USER=rentledger
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand
POSTGRES_DB=rentledger
DATABASE_URL=postgresql://rentledger:CHANGE_ME_openssl_rand@db:5432/rentledger?schema=public

JWT_SECRET=CHANGE_ME_openssl_rand

PUBLIC_APP_URL=https://rentledger.ossels.ai

# Port the web app binds on loopback for the reverse proxy (3002 is invoicy's).
FRONTEND_PORT=3003
